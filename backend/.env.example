# Server Configuration
PORT=3000

# Database Configuration (Neon PostgreSQL)
# Lấy đường link DB thật trong group chat nhé mọi người
DATABASE_URL=postgresql://your_db_user:your_db_password@your_neon_hostname/neondb?sslmode=require

# Security & Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=1d

# Redis Configuration (Local Container)
REDIS_HOST=localhost
REDIS_PORT=6379

# SMTP Mailer Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=nhap_mat_khau_ung_dung_16_ky_tu_vao_day
MAIL_FROM="Hotel Management System <your_email@gmail.com>"

# Room Image Uploads
ROOM_UPLOAD_DIRECTORY=uploads/rooms

# Avatar upload
AVATAR_MAX_FILE_SIZE_BYTES=5242880

# Cloudinary (lưu ảnh avatar — https://cloudinary.com, free tier)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
