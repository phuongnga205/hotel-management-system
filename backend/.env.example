# Server Configuration
PORT=3000
FRONTEND_URL=http://localhost:5173

# Database Configuration (Neon PostgreSQL)
# Lấy đường link DB thật trong group chat nhé mọi người
DATABASE_URL=postgresql://your_db_user:your_db_password@your_neon_hostname/neondb?sslmode=require
DATABASE_SSL_ENABLED=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# LUÔN để false — bật true (kể cả tạm thời) sẽ khiến TypeORM tự đồng bộ
# schema mỗi lần app khởi động, có thể DROP/tạo lại cột, bảng, constraint
# (kể cả rename FK sang tên hash tự sinh) trên bất kỳ DB nào DATABASE_URL
# đang trỏ tới — kể cả DB dùng chung. Xem app.module.ts.
TYPEORM_SYNCHRONIZE=false

# Seeder (chỉ bật chủ động ở local/test; không dùng DATABASE_URL production)
DATABASE_SEEDING_ENABLED=false

# Isolated PostgreSQL database for integration/E2E tests (must differ from DATABASE_URL)
E2E_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hotel_management_e2e
E2E_DATABASE_SSL_ENABLED=false
E2E_DATABASE_SSL_REJECT_UNAUTHORIZED=true
E2E_DATABASE_DESTRUCTIVE_ACK=hotel-management-e2e-only

# Security & Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=1d
OTP_TTL_SECONDS=600

# Redis Configuration (Local Container)
REDIS_HOST=localhost
REDIS_PORT=6379

# Monthly report schedule. For local mail testing only, use:
# Runs at 23:55 on days 28-31; ReportsService sends only on the actual last day.
# REPORT_CRON=* * * * *
REPORT_CRON=55 23 28-31 * *
REPORT_TIME_ZONE=Asia/Ho_Chi_Minh

# Admin statistics cache
STATISTICS_CACHE_TTL_SECONDS=300
STATISTICS_TIME_ZONE=Asia/Ho_Chi_Minh

# SMTP Mailer Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=nhap_mat_khau_ung_dung_16_ky_tu_vao_day
MAIL_FROM="Hotel Management System <your_email@gmail.com>"

# Avatar upload
AVATAR_MAX_FILE_SIZE_BYTES=5242880

# Múi giờ dùng để validate ngày check-in booking (mặc định Asia/Ho_Chi_Minh nếu bỏ trống)
HOTEL_TIMEZONE=Asia/Ho_Chi_Minh

# Cloudinary (lưu ảnh avatar + ảnh phòng — https://cloudinary.com, free tier)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
